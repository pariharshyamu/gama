{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "jsx": "react-jsx",
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "outDir": "dist",
    "baseUrl": ".",
    // The docs site imports the library by NAME, the way a consumer does.
    // Point that at the source so the site is typechecked against what is
    // in the tree rather than whatever was last built into dist.
    "paths": {
      "gama3d": ["src/index.ts"],
      "gama3d/templates": ["src/templates.ts"]
    }
  },
  "include": ["src", "tests", "examples", "site/src"]
}
