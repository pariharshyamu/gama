{
  "name": "gama",
  "version": "0.4.0",
  "description": "GAMA — Gaming And Motion Agent: a 3D game development library built on top of three.js, focused on game loops, entities, steering-based motion agents, animation, cameras and input.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./rapier": {
      "types": "./dist/rapier.d.ts",
      "import": "./dist/rapier.js",
      "require": "./dist/rapier.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/rapier.ts --format esm,cjs --dts --sourcemap --clean",
    "dev": "vite examples/basic",
    "dev:flock": "vite examples/flock",
    "dev:navmesh": "vite examples/navmesh",
    "dev:physics": "vite examples/physics",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "threejs",
    "game-engine",
    "game-development",
    "3d",
    "steering-behaviors",
    "motion",
    "agents",
    "animation",
    "webgl"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@dimforge/rapier3d-compat": ">=0.12.0",
    "three": ">=0.150.0"
  },
  "peerDependenciesMeta": {
    "@dimforge/rapier3d-compat": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@types/three": "^0.165.0",
    "three": "^0.165.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}
