# Copy to deploy/deploy.env (gitignored) and edit. deploy.sh sources it.
#
#     cp deploy/deploy.env.example deploy/deploy.env
#
# Nothing secret belongs in here. The SSH key is referenced by PATH, never
# pasted — a private key in a file next to a git repository is one `git add
# -A` away from being a public one.

# Where to ssh and rsync. The IP, not the name — this must keep working even
# when DNS does not.
DEPLOY_HOST=103.39.133.227

# Where the post-deploy smoke test looks. Deliberately separate from
# DEPLOY_HOST: the checks have to request the name on the certificate, or
# every HTTPS check fails on a name mismatch that has nothing to do with the
# deploy that just ran.
#
# Until enable-tls.sh has been run, use:  SITE_URL=http://103.39.133.227
SITE_URL=https://gama.playmeet.games

# The SSH user. Whatever you passed as DEPLOY_USER to bootstrap.sh — it owns
# /srv/gama and so can deploy without sudo.
DEPLOY_USER=root

DEPLOY_PORT=22

# Uncomment if this box needs a key that isn't your default.
# SSH_KEY=~/.ssh/gama_deploy

# Where releases live on the server. Must match bootstrap.sh's WEB_ROOT.
WEB_ROOT=/srv/gama

# How many past releases to keep for rollback.
KEEP=5
